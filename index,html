<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For My Love ❤️</title>
    <style>
        body {
            background-color: #050505;
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            overflow: hidden;
            font-family: 'Arial', sans-serif;
            color: white;
        }
        .galaxy-heart {
            font-size: 7rem;
            animation: pulse 1.5s infinite alternate;
            text-shadow: 0 0 20px #ff477e, 0 0 40px #ff477e;
        }
        @keyframes pulse {
            0% { transform: scale(1); filter: drop-shadow(0 0 10px #ff477e); }
            100% { transform: scale(1.15); filter: drop-shadow(0 0 30px #ff758c); }
        }
        h1 {
            font-size: 2.2rem;
            margin-top: 20px;
            letter-spacing: 2px;
            text-shadow: 0 0 10px rgba(255,255,255,0.5);
            text-align: center;
        }
        .sparkle {
            position: absolute;
            background: white;
            border-radius: 50%;
            animation: fall linear infinite;
        }
        @keyframes fall {
            0% { transform: translateY(-10vh) scale(0); opacity: 0; }
            50% { opacity: 1; }
            100% { transform: translateY(110vh) scale(1); opacity: 0; }
        }
        .card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 25px 40px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            z-index: 10;
        }
        p {
            font-size: 1.2rem;
            color: #ffccd5;
            margin: 10px 0 0 0;
        }
    </style>
</head>
<body>

    <div class="card">
        <div class="galaxy-heart">💖</div>
        <h1>Te Amo, Diko!</h1>
        <p>You are my favorite person in the world 🧸✨</p>
    </div>

    <script>
        function createSparkle() {
            const sparkle = document.createElement('div');
            sparkle.classList.add('sparkle');
            sparkle.innerText = Math.random() > 0.4 ? '✨' : (Math.random() > 0.5 ? '❤️' : '🧸');
            sparkle.style.left = Math.random() * 100 + 'vw';
            sparkle.style.top = '-5vh';
            sparkle.style.fontSize = Math.random() * 1.5 + 0.8 + 'rem';
            sparkle.style.animationDuration = Math.random() * 3 + 2 + 's';
            document.body.appendChild(sparkle);
            setTimeout(() => sparkle.remove(), 5000);
        }
        setInterval(createSparkle, 200);
    </script>
</body>
</html>
